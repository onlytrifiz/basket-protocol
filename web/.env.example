# Written after the Base deployment. Never put private keys or third-party secrets in NEXT_PUBLIC variables.
NEXT_PUBLIC_CHAIN_ID=8453
# The STFY token. Stand-in today: 0x0ac6…36c9 is "Stockify Test" (TEST), 1B supply, 18 decimals —
# same shape as the real one, and it has a live ETH pair on Uniswap v4 holding roughly $5k. Swap in
# the real address at deployment; nothing else needs to change, because the swap route's allowlist
# and the trade panel both read this variable.
NEXT_PUBLIC_STOCKIFY_TOKEN_ADDRESS=0x0ac61d67420f980b8a5324b0e52c8375736d36c9
NEXT_PUBLIC_DIVIDEND_VAULT_ADDRESS=0x4Ee35c658b8032a7577096B60bd51Ae9909E4f98
NEXT_PUBLIC_STOCKIFY_HOOK_ADDRESS=0x47Ec48C74f3069e9Ae69406197821996d80200cC

# Set this only once the ETH/STFY pool is initialised. It is what unlocks STFY in the trade panel:
# an address is not a market, and quoting a pool that does not exist just fails in the user's face.
NEXT_PUBLIC_STOCKIFY_POOL_ID=

# Quotes go through Velora's Market API, which needs no key. The legacy /api/uniswap routes still
# read UNISWAP_API_KEY; they are unused by the trade panel and can be removed with it.

# --- Tokenized stock hub (/stocks) ----------------------------------------------------------------

# Company fundamentals, quotes and news. Free tier at finnhub.io, 60 calls/minute — well clear of
# what this site uses (13 quotes a minute, cached). WITHOUT IT the hub still works: quotes fall back
# to Yahoo, and the fundamentals and news panels are simply omitted rather than shown empty.
FINNHUB_API_KEY=

# Optional Base endpoint, tried BEFORE the bundled public ones rather than replacing them, so an
# outage on a funded RPC degrades to a public endpoint instead of to a blank page. Worth setting in
# production: `mainnet.base.org` caps batches at 10 calls AND rate-limits per element inside them,
# which is why the bundled list leads with publicnode.
BASE_RPC_URL=
# Raise only alongside an endpoint that documents a larger batch limit.
BASE_RPC_BATCH_SIZE=

# Overrides the updates channel linked from the /stocks hero. The handle ships as a default in
# `app/components/updates-pill.tsx` precisely because this file's local counterpart is gitignored —
# configured only here, the pill would work in dev and vanish in production. Set it empty to hide
# the pill, or to another URL to repoint it.
NEXT_PUBLIC_TELEGRAM_URL=
