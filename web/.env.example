# Written after the Base deployment. Never put private keys or third-party secrets in NEXT_PUBLIC variables.
#
# EVERY VARIABLE IN THIS FILE IS READ BY THE CODE, and every variable the code reads is in this file.
# That is worth stating because it stopped being true once: this listed a pool id nothing consulted
# and an API key for routes that no longer existed, while the index factory the site depends on was
# absent. A sample file that documents settings with no effect is worse than none — it sends the next
# person to configure something and wonder why nothing changed. Check it with:
#
#   grep -rhoE 'process\.env\.[A-Z0-9_]+' app lib scripts | sed 's/process\.env\.//' | sort -u
#
# `NEXT_PUBLIC_CHAIN_ID` used to live here and is gone for that reason: nothing reads it. The chain
# is pinned in `app/components/wallet.tsx` as `BASE_CHAIN_HEX`, which is what actually decides the
# network a wallet is asked to switch to.

# --- Contracts ------------------------------------------------------------------------------------

# The STFY token — the real one, deployed on Base. It was a stand-in ("Stockify Test") for as long as
# the pool was a rehearsal; both the swap route's allowlist and the trade panel read this variable, so
# pointing it at a different token is the whole of what it takes to trade a different token.
NEXT_PUBLIC_STOCKIFY_TOKEN_ADDRESS=0xC6405D7a226e1C18E559Be2F335F74C01Ad07bF5

# The dividend vault. Read for the live index and vault state on `/` and `/dividends`, and — because
# Velora refuses to price a route for a placeholder-looking address — as the stand-in swapper that
# lets the trade panel show a quote before a wallet is connected.
NEXT_PUBLIC_DIVIDEND_VAULT_ADDRESS=0x4Ee35c658b8032a7577096B60bd51Ae9909E4f98

# The direct ETH/STFY router (`script/DeployRouter.s.sol`). Without it the swap card cannot trade
# STFY at all and says so: no aggregator will route a pool whose hook is not on its allowlist, and
# this one's will not be while it is unreviewed — Velora refuses a pair DexScreener indexes with
# real depth. Everything except ETH<->STFY keeps going through the aggregator.
NEXT_PUBLIC_STOCKIFY_ROUTER_ADDRESS=0x72557a7A026b733E94d605Fcfd96e6e162274b0A

# The index factory (`script/DeployIndices.s.sol`). What `/indices` and `/indices/create` read: the
# live set, the predicted CREATE2 address a creator is shown, and the platform fee. UNSET IS A REAL
# STATE, not a broken one — the builder says the factory is not deployed on this network and refuses
# to invent an address, which is the honest answer on a chain where it is not.
NEXT_PUBLIC_INDEX_FACTORY=0x78b50dFFE7250638D6F2A24f56B0849CefA69498

# --- Market data ----------------------------------------------------------------------------------

# Company fundamentals, quotes and news. Free tier at finnhub.io, 60 calls/minute — well clear of
# what this site uses (13 quotes a minute, cached). WITHOUT IT the hub still works: quotes fall back
# to Yahoo, and the fundamentals and news panels are simply omitted rather than shown empty.
# Swap quotes need no key at all: Velora's Market API is open.
FINNHUB_API_KEY=

# --- Base RPC -------------------------------------------------------------------------------------

# Optional Base endpoint, tried BEFORE the bundled public ones rather than replacing them, so an
# outage on a funded RPC degrades to a public endpoint instead of to a blank page. Worth setting in
# production: `mainnet.base.org` caps batches at 10 calls AND rate-limits per element inside them,
# which is why the bundled list leads with publicnode.
BASE_RPC_URL=
# Raise only alongside an endpoint that documents a larger batch limit. Default 10.
BASE_RPC_BATCH_SIZE=
# Milliseconds between chunks of one batch. Public rate limits here are per-second, so pacing the
# chunks is what stops the throttling. Default 120.
BASE_RPC_GAP_MS=
# Blocks per `eth_getLogs` request when the ledger walks a range. A REQUEST SIZE, NOT A HORIZON:
# `mainnet.base.org` refuses a span over 10,000 outright, so a wide range is chunked rather than
# refused. Default 9500.
BASE_RPC_LOG_SPAN=

# Etherscan V2 — one key serves every chain, Base included, via `chainid=8453`. Used for LOG reads
# only, and only when a range is wide: a public Base endpoint refuses an eth_getLogs over 10,000
# blocks, so a contract's whole history is walked in chunks and the chunk count grows with its AGE —
# 1 request the week the index factory shipped, 137 a month later, 1,660 after a year. Etherscan has
# no range cap, so the same history is one request forever. WITHOUT IT everything still works, just
# with the chunked walk and its growth. The same key foundry uses to verify contracts.
ETHERSCAN_API_KEY=
# Chunks a range must need before the explorer is preferred. Below it the public RPC is measurably
# faster (220ms for ten chunks vs 757ms for one explorer call); above it, it stops being bounded.
BASE_RPC_EXPLORER_AFTER=

# --- Settled-cycle ledger (/dividends) ------------------------------------------------------------

# The dividend ledger is stored rather than re-derived: a settled cycle is immutable, so each block
# range is scanned exactly once and kept in a Vercel Blob. Without a store the page can only show
# what one eth_getLogs call reaches — about five hours of Base — and every older cycle is invisible.
# Read by the @vercel/blob SDK rather than by this repo, which is why it will not appear in the grep
# above. Provisioned automatically by the Vercel Blob integration; set it locally with `vercel env pull`.
BLOB_READ_WRITE_TOKEN=

# Shared with the keeper's LEDGER_INGEST_SECRET. The keeper POSTs /api/cycles when a cycle settles
# and the route then walks the blocks since its last ingest. Unset means the route refuses every
# call, which freezes the ledger rather than corrupting it.
CYCLES_INGEST_SECRET=

# Where the cursor starts when the ledger is empty — the block the vault was deployed in. This is
# what makes the backfill automatic: the first ingest finds no cursor, starts here and walks the
# whole history in chunked requests. Left unset, the ledger silently begins at whenever the first
# ingest happened to run and everything before it is lost with no error to notice.
VAULT_DEPLOY_BLOCK=50148429

# --- Content --------------------------------------------------------------------------------------

# Overrides the updates channel linked from the /stocks hero. The handle ships as a default in
# `app/components/updates-pill.tsx` precisely because this file's local counterpart is gitignored —
# configured only here, the pill would work in dev and vanish in production. Set it empty to hide
# the pill, or to another URL to repoint it.
NEXT_PUBLIC_TELEGRAM_URL=

# Overrides the X account linked from the header. The handle ships as a default in
# `app/components/site-chrome.tsx` for the same reason the Telegram one does: this file's local
# counterpart is gitignored, so a link set only there works in dev and vanishes in production. It was
# verified before being hardcoded — x.com/Stockify_fi answers 200 without redirecting. Set it empty
# to remove the icon.
NEXT_PUBLIC_X_URL=

# --- Shop (/shop) ---------------------------------------------------------------------------------

# The shop: gift cards, eSIM data and mobile top-ups, fulfilled by CryptoRefills and paid for with
# the stock the vault distributes. Browsing needs none of this; SELLING needs the partner id.

# REQUIRED TO SELL, and silent if missing. The supplier does not enforce this header — catalogue and
# order calls both succeed without it — so an unset id would let every sale complete and earn no
# commission, with nothing in the logs to show for it. `POST /api/shop/order` therefore refuses with
# a 503 rather than selling unattributed. The catalogue, prices and the order tracker are unaffected.
CRYPTOREFILLS_PARTNER_ID=
# Overrides for the supplier endpoint and the version header it is called with. Defaults are
# https://api.cryptorefills.com and 1.0.0; there is no reason to set either outside a test.
CRYPTOREFILLS_API_BASE=
CRYPTOREFILLS_APP_VERSION=

# Optional Neon order ledger — our own copy of what was sold, so "what did we sell, to whom, for how
# much" can be answered without logging into the supplier. NOTHING IS ON THE CRITICAL PATH: unset, or
# down, orders still go through and the shop keeps working. It deliberately stores no redeem codes:
# those are bearer instruments, so a leak of the table would be a leak of spendable value.
DATABASE_URL=

# Guards /shop/admin/orders, which lists customer emails and phone numbers. UNSET MEANS THE PAGE
# DOES NOT EXIST — it 404s rather than defaulting open.
ADMIN_TOKEN=

# The catalogue a visitor sees before they choose a country. The country is otherwise guessed from
# the edge's geo header and only written to a cookie when the shopper picks one themselves. Default US.
NEXT_PUBLIC_DEFAULT_COUNTRY=

# Where a stalled order sends someone, offered two minutes after a payment goes out. Defaults to the
# updates channel in `app/components/shop/order-tracker.tsx`.
NEXT_PUBLIC_SUPPORT_URL=

# The address a price check is made under, before anyone has said who they are. It receives nothing —
# a real address is collected at checkout. Default quote@stockify.finance.
SHOP_QUOTE_EMAIL=

# --- Shop: payment tuning --------------------------------------------------------------------------

# EVERY ONE OF THESE CAN ONLY MAKE A PAYMENT COST THE BUYER SLIGHTLY MORE. The order is paid by an
# exact-output swap, so the delivered amount is fixed by construction and none of these can settle an
# order short. Raising one buys safety margin; lowering one buys a few cents.

# Asked for on top of what the order needs, so rounding can never underpay it. Also floored at a cent
# in `lib/shop/settlement.ts`. Default 0.002.
NEXT_PUBLIC_PAYMENT_BUFFER_RATE=
# How far the swap's INPUT may drift before it reverts, in bps. Default 300.
SHOP_PAY_SLIPPAGE_BPS=
# The same, for the tokenized equities, which trade in thinner books. Default 500.
SHOP_PAY_SLIPPAGE_BPS_EQUITY=
# Headroom on the STFY sale over what its ETH leg needs. Paying in STFY is two transactions — sell
# through the router, then pay — and this is what stops the second coming up short if ETH moves
# between them. Whatever ETH is left over stays in the buyer's wallet. Default 150.
SHOP_PAY_ROUTER_HEADROOM_BPS=
