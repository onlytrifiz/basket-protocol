# Base mainnet RPC — use a production provider in place of the public endpoint.
RPC_URL=https://mainnet.base.org

# Keeper account — must be authorised via DividendVault.setKeeper(addr, true) and hold ETH for gas.
KEEPER_PRIVATE_KEY=0x...

# Deployed vault address
VAULT_ADDRESS=0x...

# Routes are built in-process against Aerodrome Slipstream (WETH -> USDC -> equity) and priced by
# simulating the router itself, so there is no aggregator API key and no third-party dependency
# between a hook fee arriving and the purchase.
ROUTE_DEADLINE_SEC=900

# Keeper policy. Dividend recipients come from StockifyToken's on-chain registry, not Etherscan.
# The real trigger is the vault cap, not this: the keeper defers until availableEth reaches
# maxGrossSpendPerCycle, because only then is the per-leg spend predictable enough to quote exactly.
# Cap is 0.01 ETH on Base today, i.e. 0.00225 per leg — verified to quote on all four assets with no
# more price impact than twice that size. This floor only guards against dust runs.
MIN_ETH_TO_BUY=0.002
SLIPPAGE_BPS=300
INTERVAL_SEC=300
SNAPSHOT_BATCH_SIZE=250
PAYOUT_BATCH_SIZE=25
MAX_BATCH_TRANSACTIONS=100
# DRY_RUN=1
