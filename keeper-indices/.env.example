# Base mainnet. A dedicated endpoint, not a public one: a cycle is a handful of eth_calls per basket
# plus a holder-balance multicall, and the payout transactions add gas estimation and receipt polling.
RPC_URL=https://base-mainnet.g.alchemy.com/v2/YOUR_KEY
CHAIN_ID=8453

# The keeper account. Must be authorised on the factory via setKeeper(addr, true) — which after the
# ownership handover only 0x2A201Ada10b55F1979C8f5e5C303C8a3cDE44C71 can call — and hold ETH for gas.
KEEPER_PRIVATE_KEY=0x...

INDEX_FACTORY=0x78b50dFFE7250638D6F2A24f56B0849CefA69498
FEE_LOCKER=0x71D1D363176723f85d98B8B430DF33cde89f0A7f

# The holder list, and the only third party a round depends on. `tokenholderlist` is an Etherscan
# **Pro** endpoint: without Pro it answers with an error, which this reads as a failure and skips the
# round rather than paying nobody. Base's Blockscout is not a fallback — it serves token metadata but
# does not index balances, and returns an empty holder set for every token.
ETHERSCAN_API_KEY=

# Routing needs no key: Velora's Market API is open, which is why the sibling protocol's keeper
# already routes its live buys through it. The treasury only calls venues its factory allowlists, so
# a route is checked against that list before it is submitted.
SLIPPAGE_BPS=300

# A name is bought only once its own slice is worth this much — per name, not per round. A basket of
# seven therefore needs seven times this accumulated before it moves at all.

# Payout batching. Base's block gas limit is 30M, so a batch has to fit well inside it.
MAX_HOLDERS_PER_TX=150

INTERVAL_SEC=300
# DRY_RUN=1
# ONLY_INDEXES=0x...

# --- What is worth doing, in dollars --------------------------------------------------------------
#
# Both gates are dollar amounts because both weigh a slice against what it costs to move it, and a
# transaction costs dollars. Stated in units of the quote asset — as they were — the same constant
# meant $20 against a stablecoin and $6,245 against a tokenized share.

# Fees are collected only once this much has accrued. A collect is 335k-449k gas — about one and a
# half swaps — and a creator fee stream arrives as a trickle, so without this the keeper cranks every
# five minutes to move fractions of a cent. Nothing is lost by waiting: the fees sit in the locker,
# and harvest() reports everything unsplit rather than what one call brought in.
MIN_HARVEST_USD=10

# A name's slice must be worth this before it is bought. The swap itself is cheap (306k gas, well
# under a cent at ordinary Base gas), so this is about not paying a spread on dust.
MIN_ROUND_USD=10

# A round must be worth this before it is paid out. The payout is the expensive half by a wide
# margin: ~72,000 gas PER HOLDER measured on live batches, so 150 holders is ~11M gas — thirty-five
# times a swap — and distribute() runs once per basket entry. The gas is the keeper's, not the
# treasury's.
MIN_PAYOUT_USD=20

# And the ratio that survives a gas spike, which a fixed floor cannot: at 0.3 gwei a 150-holder round
# costs about $7.60, which would take a third of a $20 payout. Applies to every quote asset now.
PAYOUT_COST_MAX_BPS=500

# The floor used when a quote asset cannot be priced at all. Permissive on purpose: the old fallback
# refused forever, and an unpriced asset should cost a check, not the programme.
MIN_ROUND_UNPRICED=0.000001

# How many times a quote is asked for when the aggregator does not answer. A refusal WITH a reason
# is not retried — "no routes found" says the same thing in two seconds. This is for timeouts, 502s
# and rate limits, which say nothing about whether a route exists.
#
# It matters most for the equities, which have no fallback and must not have one: B20 depth is split
# across venues, so routing them by hand would mean picking one and hoping it is the deep one.
VELORA_RETRIES=3

# The tier the launchpad opens its pools at. Used only for the buyback's direct fallback: a launch
# coin has one pool, and it is the pool the aggregator would route to anyway.
LAUNCH_FEE_TIER=10000
