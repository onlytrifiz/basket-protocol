{
  "name": "stockify-indices-keeper",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Keeper for Stonks Baskets: harvests a launch's creator fees, buys the basket through an allowlisted venue, and pays it out to the coin holders",
  "scripts": {
    "start": "tsx src/keeper.ts",
    "once": "RUN_ONCE=1 tsx src/keeper.ts",
    "status": "RUN_ONCE=1 DRY_RUN=1 tsx src/keeper.ts"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "tsx": "^4.19.0",
    "viem": "^2.21.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=20"
  }
}
